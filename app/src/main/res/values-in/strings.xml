    <string name="settings_face_licences">Lisensi pengenalan wajah</string>
    <string name="settings_face_licences_credit">OpenCV, YuNet, dan SFace</string>
    <string name="face_licences_intro">Pemberitahuan untuk perangkat lunak dan model yang menemukan wajah di ponsel ini.</string>
    <string name="face_licences_loading">Memuat pemberitahuan</string>
