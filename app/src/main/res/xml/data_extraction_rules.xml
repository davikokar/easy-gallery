<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="media_index.db"/>
        <exclude domain="database" path="media_index.db-wal"/>
        <exclude domain="database" path="media_index.db-shm"/>
        <exclude domain="sharedpref" path="media_index_run_state.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="media_index.db"/>
        <exclude domain="database" path="media_index.db-wal"/>
        <exclude domain="database" path="media_index.db-shm"/>
        <exclude domain="sharedpref" path="media_index_run_state.xml"/>
    </device-transfer>
</data-extraction-rules>